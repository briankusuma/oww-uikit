{
  "name": "oww-uikit",
  "version": "0.1.0",
  "description": "OWW Design System & UI Kit Sass Architecture",
  "main": "dist/uikit.css",
  "scripts": {
    "build": "npm run build:css && npm run build:assets",
    "build:css": "sass src/scss/uikit.scss dist/uikit.css --style=expanded --no-source-map",
    "build:min": "sass src/scss/uikit.scss dist/uikit.min.css --style=compressed --no-source-map",
    "build:assets": "node -e \"const fs = require('fs'); fs.cpSync('src/js', 'dist/js', { recursive: true }); fs.cpSync('src/assets', 'dist/assets', { recursive: true });\"",
    "watch": "sass --watch src/scss/uikit.scss dist/uikit.css --style=expanded",
    "watch:css": "sass --watch src/scss/uikit.scss dist/uikit.css --style=expanded",
    "serve:live": "browser-sync start --server --files \"dist/uikit.css, *.html\" --no-notify",
    "dev": "concurrently -n \"sass,browser\" -c \"magenta,cyan\" \"npm run watch\" \"npm run serve:live\"",
    "open": "open index.html",
    "serve": "npx -y serve ."
  },
  "keywords": [
    "design-system",
    "uikit",
    "sass",
    "scss",
    "css"
  ],
  "author": "Brian",
  "license": "MIT",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "sass": "^1.85.0"
  }
}
